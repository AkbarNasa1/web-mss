---
import "../styles/global.css";
import Footer from "../components/elements/Footer.astro";
import Navbar from "../components/elements/Navbar.astro";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logos/logoCV.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="CV MITRA SUPPLY SPACE" />
    <title>CV MITRA SUPPLY SPACE {title ? `- ${title}` : ''}</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- SCRIPT TEMA DIRECT DI HEAD (Mencegah kedipan & mengaktifkan class .dark langsung) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem("appTheme");
        if (
          savedTheme === "dark" ||
          (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
  </head>

  <body class="bg-body min-h-screen flex flex-col justify-between overflow-x-hidden">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- SCRIPT EVENT INTERAKSI -->
    <script is:inline>
      function initAppEvents() {
        // 1. TOGGLE THEME MODE (Bisa diklik di Desktop maupun Mobile)
        const themeBtns = document.querySelectorAll('[data-switch-theme]');
        themeBtns.forEach((btn) => {
          // Gunakan onclick langsung agar listener tidak tertumpuk
          btn.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();

            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('appTheme', isDark ? 'dark' : 'light');
          };
        });

        // 2. HAMBURGER MENU (Hanya berlaku untuk layar Mobile jika elemen tersedia)
        const toggleMenu = document.querySelector('[data-toggle-nav]');
        const navbar = document.querySelector('[data-navbar]');
        const overlayNav = document.querySelector('[data-nav-overlay]');

        if (toggleMenu && navbar && overlayNav) {
          const closeMenu = () => {
            toggleMenu.setAttribute('data-open-nav', 'false');
            overlayNav.setAttribute('data-is-visible', 'false');
            document.body.classList.remove('!overflow-y-hidden');
            // Hanya reset height jika dalam kondisi mobile (kurang dari lg / 1024px)
            if (window.innerWidth < 1024) {
              navbar.style.height = '0px';
            }
          };

          toggleMenu.onclick = (e) => {
            e.preventDefault();
            const isOpen = toggleMenu.getAttribute('data-open-nav') === 'true';

            if (!isOpen) {
              toggleMenu.setAttribute('data-open-nav', 'true');
              overlayNav.setAttribute('data-is-visible', 'true');
              document.body.classList.add('!overflow-y-hidden');
              navbar.style.height = `${navbar.scrollHeight}px`;
            } else {
              closeMenu();
            }
          };

          overlayNav.onclick = closeMenu;
        }
      }

      // Jalankan fungsi saat pertama dimuat dan saat halaman berpindah
      initAppEvents();
      document.addEventListener('astro:page-load', initAppEvents);
    </script>
  </body>
</html>