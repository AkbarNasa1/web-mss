---
export interface DropdownItem {
  href: string;
  text: string;
}

export interface Props {
  href?: string;
  text: string;
  dropdown?: DropdownItem[];
}

const { href, text, dropdown } = Astro.props;
---

<div class="relative group">
  {dropdown ? (
    <>
      <button
        type="button"
        data-dropdown-toggle
        class="flex items-center justify-between gap-2 w-full text-left"
      >
        <span>{text}</span>

        <svg
          data-dropdown-icon
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4 transition-transform duration-300 lg:group-hover:rotate-180"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M5.23 7.21a.75.75 0 011.06.02L10 11.293l3.71-4.06a.75.75 0 111.08 1.04l-4.25 4.65a.75.75 0 01-1.08 0l-4.25-4.65a.75.75 0 01.02-1.06z"
            clip-rule="evenodd"
          />
        </svg>
      </button>

      <div
        data-dropdown-panel
        class="hidden lg:block
               lg:absolute lg:left-0 lg:top-full lg:pt-3
               lg:opacity-0 lg:invisible lg:translate-y-2
               lg:group-hover:opacity-100
               lg:group-hover:visible
               lg:group-hover:translate-y-0
               transition-all duration-300 z-50"
      >
        <div
          class="w-full pl-4 lg:pl-0 lg:w-56 rounded-xl
                 bg-transparent
                 lg:bg-white lg:dark:bg-gray-900
                 lg:shadow-xl
                 lg:border lg:border-gray-100 lg:dark:border-gray-700
                 py-2"
        >
          {dropdown.map((item) => (
            <a
              href={item.href}
              class="block px-4 py-2 text-sm font-medium
                     text-gray-800 dark:text-gray-200
                     hover:text-primary
                     hover:bg-gray-50 dark:hover:bg-gray-800
                     transition-colors"
            >
              {item.text}
            </a>
          ))}
        </div>
      </div>
    </>
  ) : (
    <a href={href} class="block">
      {text}
    </a>
  )}
</div>

<script>
  document.querySelectorAll("[data-dropdown-toggle]").forEach((button) => {
    button.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();

      const parent = button.closest(".group");
      const panel = parent?.querySelector("[data-dropdown-panel]") as HTMLElement | null;
      const icon = parent?.querySelector("[data-dropdown-icon]") as SVGElement | null;

      if (!panel) return;

      const isOpen = !panel.classList.contains("hidden");

      if (isOpen) {
        panel.classList.add("hidden");
        icon?.classList.remove("rotate-180");
      } else {
        panel.classList.remove("hidden");
        icon?.classList.add("rotate-180");
      }
    });
  });
</script>
