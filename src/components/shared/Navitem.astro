---
export interface DropdownItem {
  href: string;
  text: string;
}

export interface Props {
  href?: string;
  text: string;
  dropdown?: DropdownItem[];
}

const { href, text, dropdown } = Astro.props;
---

<div class="relative group w-full lg:w-auto">
  {
    dropdown ? (
      <>
        <button
          type="button"
          data-dropdown-toggle
          class="flex items-center justify-between gap-2 w-full text-left py-2 px-1 text-heading-1 hover:text-primary transition-colors font-medium"
        >
          <span>{text}</span>

          <svg
            data-dropdown-icon
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 transition-transform duration-300 lg:group-hover:rotate-180 text-heading-2"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M5.23 7.21a.75.75 0 011.06.02L10 11.293l3.71-4.06a.75.75 0 111.08 1.04l-4.25 4.65a.75.75 0 01-1.08 0l-4.25-4.65a.75.75 0 01.02-1.06z"
              clip-rule="evenodd"
            />
          </svg>
        </button>

        <div
          data-dropdown-panel
          class="hidden lg:block
                 lg:absolute lg:left-0 lg:top-full lg:pt-2
                 lg:opacity-0 lg:invisible lg:translate-y-2
                 lg:group-hover:opacity-100
                 lg:group-hover:visible
                 lg:group-hover:translate-y-0
                 transition-all duration-300 z-50 w-full lg:w-auto"
        >
          <div
            class="w-full pl-4 lg:pl-0 lg:w-56 rounded-xl
                   bg-transparent lg:bg-box-bg
                   lg:shadow-xl
                   lg:border lg:border-box-border
                   py-2 my-1 lg:my-0 flex flex-col gap-1"
          >
            {dropdown.map((item) => (
              <a
                href={item.href}
                class="block px-4 py-2 text-sm font-medium
                       text-heading-2
                       hover:text-primary
                       hover:bg-box-border/30 rounded-lg
                       transition-colors"
              >
                {item.text}
              </a>
            ))}
          </div>
        </div>
      </>
    ) : (
      <a 
        href={href} 
        class="block py-2 px-1 text-heading-1 hover:text-primary transition-colors font-medium"
      >
        {text}
      </a>
    )
  }
</div>

<!-- Script Dropdown yang Aman untuk Astro Router -->
<script is:inline>
  function setupDropdowns() {
    const buttons = document.querySelectorAll("[data-dropdown-toggle]");

    buttons.forEach((button) => {
      // Hapus listener lama jika ada agar tidak double-trigger
      const newButton = button.cloneNode(true);
      button.parentNode?.replaceChild(newButton, button);

      newButton.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const parent = newButton.closest(".group");
        const panel = parent?.querySelector("[data-dropdown-panel]");
        const icon = parent?.querySelector("[data-dropdown-icon]");

        if (!panel) return;

        // Toggle kelas 'hidden'
        const isHidden = panel.classList.contains("hidden");

        if (isHidden) {
          panel.classList.remove("hidden");
          icon?.classList.add("rotate-180");
        } else {
          panel.classList.add("hidden");
          icon?.classList.remove("rotate-180");
        }
      });
    });
  }

  // Jalankan saat halaman siap
  setupDropdowns();
  document.addEventListener("astro:page-load", setupDropdowns);
</script>