---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";

const footerCompany = [
  { itemText: "Beranda", itemLink: "/" },
  { itemText: "Sejarah", itemLink: "/tentang-kami/history" },
  { itemText: "Visi & Misi", itemLink: "/tentang-kami/visimision" },
  { itemText: "Struktur Organisasi", itemLink: "/tentang-kami/orgStruct" },
  { itemText: "Proyek Kami", itemLink: "/proyek-layanan/proyek" },
  { itemText: "Layanan Kami", itemLink: "/proyek-layanan/layanan" },
  { itemText: "Hubungi Kami", itemLink: "/kontak/hubungi-kami" },
];
---

<div class="mt-16"></div>
<footer class="relative bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent pt-28 rounded-t-3xl overflow-hidden">
  <!-- Decorative Glow Effects -->
  <div class="absolute right-0 top-0 h-full w-full flex justify-end pointer-events-none">
    <div class="w-28 h-28 overflow-hidden flex rounded-xl relative blur-2xl">
      <span class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"></span>
      <span class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"></span>
      <span class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"></span>
    </div>
  </div>

  <div class="absolute left-0 bottom-0 h-full w-full flex items-end pointer-events-none">
    <div class="w-28 h-28 overflow-hidden flex rounded-xl relative blur-2xl">
      <span class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"></span>
      <span class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"></span>
      <span class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"></span>
    </div>
  </div>

  <Container className="pb-8 relative">
    <span class="absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 blur-2xl opacity-20 w-24 h-16 sm:w-48 sm:h-36 rounded-full rotate-12 skew-x-6 bg-primary pointer-events-none"></span>
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 relative z-10">
      
      <!-- Kolom 1: Profil Perusahaan -->
      <div class="lg:col-span-4 flex flex-col justify-between">
        <div>
          <a href="/" class="relative flex items-center gap-3">
            <span
              aria-label="Logo"
              class="w-10 h-10 inline-block bg-heading-1"
              style="
                -webkit-mask-image: url('/logos/logoCV.png');
                mask-image: url('/logos/logoCV.png');
                -webkit-mask-size: contain;
                mask-size: contain;
                -webkit-mask-repeat: no-repeat;
                mask-repeat: no-repeat;
                -webkit-mask-position: center;
                mask-position: center;
              "
            ></span>
            <div class="inline-flex text-lg font-bold text-heading-1 tracking-tight">
              CV MITRA SUPPLY SPACE
            </div>
          </a>
          <Paragraph className={"mt-6"}>
            Berkembang Bersama, Melayani Sepenuh Hati.
          </Paragraph>
        </div>

        <!-- Social Links -->
        <div class="min-h-max flex items-center gap-4 text-heading-3 mt-6">
          <a href="#" class="transition hover:text-heading-1 hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-5 h-5" viewBox="0 0 16 16">
              <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z"/>
            </svg>
            <span class="sr-only">Facebook</span>
          </a>

          <a href="#" class="transition hover:text-heading-1 hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-5 h-5" viewBox="0 0 16 16">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/>
            </svg>
            <span class="sr-only">LinkedIn</span>
          </a>

          <a href="#" class="transition hover:text-heading-1 hover:scale-105">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="w-5 h-5" viewBox="0 0 16 16">
              <path d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"/>
            </svg>
            <span class="sr-only">Twitter</span>
          </a>
        </div>
      </div>

      <!-- Kolom 2: Navigasi Menu Halaman -->
      <div class="lg:col-span-3">
        <h3 class="text-base font-bold text-heading-1 mb-4">Navigasi</h3>
        <ul class="space-y-2.5 text-sm font-medium text-heading-3">
          {footerCompany.map((item) => (
            <li>
              <a href={item.itemLink} class="hover:text-primary transition-colors">
                {item.itemText}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Kolom 3: Google Maps Embed Spesifik -->
      <div class="lg:col-span-5 flex flex-col gap-3">
        <h3 class="text-base font-bold text-heading-1">Lokasi Kami</h3>
        <div class="w-full h-52 rounded-2xl overflow-hidden border border-box-border shadow-sm">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d494.9560523054668!2d107.60567072116234!3d-7.050534909004925!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sid!4v1788860272266!5m2!1sen!2sid" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>

    </div>
  </Container>

  <!-- Copyright Bar -->
  <div class="bg-gradient-to-tl from-box-bg py-4 relative z-10 border-t border-box-border/30">
    <Container>
      <div class="flex justify-between items-center gap-6 text-sm text-heading-3">
        <div>
          &copy; {new Date().getFullYear()} CV MITRA SUPPLY SPACE. All rights reserved.
        </div>
      </div>
    </Container>
  </div>
</footer>