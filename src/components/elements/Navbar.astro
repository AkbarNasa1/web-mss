---
import Container from "../shared/Container.astro";
import Navitem from "../shared/Navitem.astro";

const navItems = [
  { href: "/", text: "Beranda" },
  {
    text: "Tentang Kami",
    dropdown: [
      { href: "/tentang-kami/history", text: "Sejarah" },
      { href: "/tentang-kami/visimision", text: "Visi & Misi" },
      { href: "/tentang-kami/orgStruct", text: "Struktur Organisasi" },
    ],
  },
  {
    href: "/proyek-layanan",
    text: "Proyek & Layanan",
    dropdown: [
      { href: "/proyek-layanan/proyek", text: "Proyek Kami" },
      { href: "/proyek-layanan/layanan", text: "Layanan Kami" },
    ],
  },
  {
    href: "/dokumentasi",
    text: "Dokumentasi",
    dropdown: [
      { href: "/dokumentasi/foto", text: "Foto" },
      { href: "/dokumentasi/berita", text: "Berita" },
    ],
  },
  {
    href: "/kontak",
    text: "Kontak",
    dropdown: [{ href: "/kontak/hubungi-kami", text: "Hubungi Kami" }],
  },
];
---

<!-- HEADER NAVBAR UTAMA -->
<header class="absolute inset-x-0 top-0 z-40 py-6">
  <Container>
    <nav class="w-full flex justify-between items-center relative">
      <!-- Logo & Nama Perusahaan Header Utama -->
      <a href="/" class="flex items-center gap-3">
        <span
          aria-label="Logo"
          class="w-10 h-10 inline-block bg-heading-1"
          style="
            -webkit-mask-image: url('/logos/logoCV.png');
            mask-image: url('/logos/logoCV.png');
            -webkit-mask-size: contain;
            mask-size: contain;
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            -webkit-mask-position: center;
            mask-position: center;
          "
        ></span>
        <span class="text-lg font-bold text-heading-1 tracking-tight">
          CV MITRA SUPPLY SPACE
        </span>
      </a>

      <!-- Menu Desktop (Layar Lebar) -->
      <div class="hidden lg:flex items-center gap-x-6">
        <ul class="flex flex-row gap-x-3 text-base text-heading-2 items-center">
          {navItems.map((item) => <Navitem {...item} />)}
        </ul>

        <!-- Switch Theme Desktop -->
        <button 
          data-switch-theme 
          aria-label="switch theme desktop"
          class="outline-none flex relative text-heading-2 rounded-full p-2.5 border border-box-border bg-box-bg hover:text-primary transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 dark:flex hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 dark:hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
        </button>
      </div>

      <!-- Tombol Hamburger Mobile -->
      <button 
        id="open-nav-btn" 
        aria-label="open mobile navigation"
        class="lg:hidden outline-none p-2 text-heading-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </nav>
  </Container>
</header>

<!-- POPUP MODAL MOBILE FULLSCREEN (PERFEK SESUAI GAMBAR ACUAN) -->
<div 
  id="mobile-menu-modal"
  class="fixed inset-0 z-[9999] hidden flex-col justify-between p-6 bg-box-bg w-full h-full min-h-screen overflow-y-auto"
>
  <!-- Top Bar: Logo + Nama Perusahaan di Kiri & Tombol X di Kanan -->
  <div class="flex items-center justify-between w-full pb-4 border-b border-box-border/30">
    <a href="/" class="flex items-center gap-3">
      <span
        aria-label="Logo"
        class="w-9 h-9 inline-block bg-heading-1"
        style="
          -webkit-mask-image: url('/logos/logoCV.png');
          mask-image: url('/logos/logoCV.png');
          -webkit-mask-size: contain;
          mask-size: contain;
          -webkit-mask-repeat: no-repeat;
          mask-repeat: no-repeat;
          -webkit-mask-position: center;
          mask-position: center;
        "
      ></span>
      <span class="text-base font-bold text-heading-1 tracking-tight">
        CV MITRA SUPPLY SPACE
      </span>
    </a>

    <!-- Tombol Close (X) -->
    <button 
      id="close-nav-btn" 
      aria-label="close navigation" 
      class="p-2 text-heading-1 hover:opacity-70 transition-opacity"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Body Menu Navigasi Mobile -->
  <div class="my-auto py-6">
    <ul class="flex flex-col gap-y-4 text-base font-medium text-heading-2">
      {navItems.map((item) => (
        item.dropdown ? (
          <li class="w-full">
            <details class="group [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex items-center justify-between py-2 text-heading-1 font-semibold cursor-pointer select-none">
                <span>{item.text}</span>
                <svg class="w-4 h-4 transition-transform duration-300 group-open:rotate-180 text-heading-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <div class="pl-4 pt-1 pb-2 flex flex-col gap-2 border-l-2 border-box-border/50 my-1">
                {item.dropdown.map((sub) => (
                  <a href={sub.href} class="py-1 text-sm text-heading-2 hover:text-primary transition-colors">
                    {sub.text}
                  </a>
                ))}
              </div>
            </details>
          </li>
        ) : (
          <li>
            <a href={item.href} class="block py-2 text-heading-1 font-semibold hover:text-primary transition-colors">
              {item.text}
            </a>
          </li>
        )
      ))}
    </ul>
  </div>

  <!-- Bottom Bar: Tombol Switch Theme (Pojok Kanan Bawah) -->
  <div class="flex justify-end pt-4 border-t border-box-border/30">
    <button 
      data-switch-theme 
      aria-label="switch theme mobile modal"
      class="p-3 text-heading-2 hover:text-primary transition-colors rounded-full border border-box-border bg-body"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 dark:flex hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 dark:hidden">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
      </svg>
    </button>
  </div>
</div>

<!-- SCRIPT UNTUK TOGGLE POPUP & DARK MODE -->
<script is:inline>
  function setupNavModal() {
    const openBtn = document.getElementById('open-nav-btn');
    const closeBtn = document.getElementById('close-nav-btn');
    const modal = document.getElementById('mobile-menu-modal');
    const switchThemeBtns = document.querySelectorAll('[data-switch-theme]');

    openBtn?.addEventListener('click', () => {
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      document.body.style.overflow = 'hidden'; // Menghindari scroll halaman utama saat modal terbuka
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = ''; // Mengembalikan scroll halaman utama
    });

    switchThemeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      });
    });
  }

  setupNavModal();
  document.addEventListener('astro:page-load', setupNavModal);
</script>