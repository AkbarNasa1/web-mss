---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/Container.astro";
---

<Layout title="Hubungi Kami - CV Mitra Supply Space">
  <section class="relative pt-32 lg:pt-36 pb-16 min-h-screen">
    <Container className="flex flex-col lg:flex-row gap-0 rounded-3xl overflow-hidden shadow-lg border border-box-border bg-box-bg">
      
      <!-- Kiri: Form Kritik & Saran -->
      <div class="flex-1 p-8 sm:p-10 lg:p-12 bg-body">
        <h2 class="text-2xl sm:text-3xl font-bold text-heading-1">
          Kirim Pesan untuk Kami
        </h2>

        <!--  LINK FORMSPREE -->
        <form 
          action="https://formspree.io/f/xvkoweav" 
          method="POST" 
          class="mt-8 space-y-6"
        >
          <!-- Row 1: Nama & Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="relative">
              <input 
                type="text" 
                id="fullname" 
                name="fullname" 
                placeholder="Nama Lengkap" 
                class="w-full pb-2 border-b border-box-border bg-transparent outline-none focus:border-primary text-heading-3 placeholder:text-heading-3/60 transition-colors"
                required
              />
            </div>
            <div class="relative">
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="Alamat Email" 
                class="w-full pb-2 border-b border-box-border bg-transparent outline-none focus:border-primary text-heading-3 placeholder:text-heading-3/60 transition-colors"
                required
              />
            </div>
          </div>

          <!-- Row 2: Judul & Telepon -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="relative">
              <input 
                type="text" 
                id="subject" 
                name="subject" 
                placeholder="Judul" 
                class="w-full pb-2 border-b border-box-border bg-transparent outline-none focus:border-primary text-heading-3 placeholder:text-heading-3/60 transition-colors"
                required
              />
            </div>
            <div class="relative">
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                placeholder="Nomor Telepon" 
                class="w-full pb-2 border-b border-box-border bg-transparent outline-none focus:border-primary text-heading-3 placeholder:text-heading-3/60 transition-colors"
                required
              />
            </div>
          </div>

          <!-- Row 3: Textarea -->
          <div class="relative">
            <textarea 
              id="message" 
              name="message" 
              rows="3" 
              placeholder="Kritik dan Saran" 
              class="w-full pb-2 border-b border-box-border bg-transparent outline-none focus:border-primary text-heading-3 placeholder:text-heading-3/60 transition-colors resize-none"
              required
            ></textarea>
          </div>

          <!-- Row 4: Tombol -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
            <button 
              type="submit" 
              class="px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-full font-medium transition-colors flex items-center justify-center gap-2 min-w-max"
            >
              Kirim Pesan
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Kanan: Info Kontak -->
      <div class="lg:w-5/12 p-8 sm:p-10 lg:p-12 bg-box-bg/50 border-t lg:border-t-0 lg:border-l border-box-border flex flex-col justify-between">
        <div>
          <div class="space-y-6">
            <div>
              <h4 class="text-base font-semibold text-heading-1 mb-1">
                Lokasi Kita
              </h4>
              <p class="text-sm text-heading-3 leading-relaxed">
                Kampung Cijengkol Dusun No. 45 Desa Kelurahan Mangunjaya
                Kabupaten Bandung, Jawa Barat, 40379
                Indonesia<br />
              </p>
            </div>

            <div>
              <h4 class="text-base font-semibold text-heading-1 mb-1">
                Alamat Email
              </h4>
              <p class="text-sm text-heading-3">
                mitrasupplyspace2026@gmail.com
              </p>
            </div>

            <div>
              <h4 class="text-base font-semibold text-heading-1 mb-1">
                Nomor Telepon
              </h4>
              <p class="text-sm text-heading-3">
                +62 899 892 2883
              </p>
            </div>
          </div>
        </div>
      </div>

    </Container>
  </section>
</Layout>