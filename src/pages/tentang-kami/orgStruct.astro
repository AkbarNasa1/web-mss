---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/Container.astro";
import Title from "../../components/shared/Title.astro";
import Paragraph from "../../components/shared/Paragraph.astro";

const tier1 = { title: "Komisaris Utama", name: "Soni Tri Senjaya" };
const tier2 = { title: "Direktur Utama", name: "Putri Karina Anggraeni" };
const tier3 = [
    { title: "Sekretaris", name: "Sulthan Yanuar A" },
    { title: "Direktur Operasional", name: "Yogi Budiman" },
    { title: "Direktur Keuangan", name: "Akbar Nasa" },
];
const tier4 = [
    { title: "Manajer Operasional", name: "Rifqi Hendrawan" },
    { title: "Manajer Pemasaran", name: "Aulia Tauhid A" },
    { title: "Human Resource Department", name: "Ramadansyah" },
];
const staffDivisions = [
    "Staff Percetakan & Penerbitan", "Staff Alat Tulis & Gambar", "Staff Pakaian",
    "Staff Kreatif Iklan", "Staff Agen Perjalanan", "Staff Kebersihan Bangunan", "Staff Real Estat",
];
---

<Layout title="| Struktur Organisasi">
    <main class="relative pt-32 pb-20 overflow-hidden">

        <!-- Blob dekoratif tersebar sepanjang halaman -->
        <div class="absolute top-0 -left-20 w-72 h-72 bg-gradient-to-br from-blue-500 to-primary rounded-full blur-3xl opacity-30 pointer-events-none"></div>
        <div class="absolute top-10 -right-20 w-80 h-80 bg-gradient-to-br from-green-400 to-teal-500 rounded-full blur-3xl opacity-25 pointer-events-none"></div>
        <div class="absolute top-[900px] -left-24 w-72 h-72 bg-gradient-to-br from-green-400 to-primary rounded-full blur-3xl opacity-20 pointer-events-none"></div>
        <div class="absolute top-[1500px] -right-16 w-64 h-64 bg-gradient-to-br from-blue-400 to-teal-400 rounded-full blur-3xl opacity-20 pointer-events-none"></div>
        <div class="absolute bottom-0 left-1/3 w-72 h-72 bg-gradient-to-br from-primary to-green-400 rounded-full blur-3xl opacity-20 pointer-events-none"></div>

        <!-- Hero -->
        <section id="struktur-hero" class="relative">
            <Container>
                <div class="max-w-3xl mx-auto text-center relative">
                    <span class="inline-block text-sm font-semibold text-primary tracking-wide uppercase mb-4">Tentang Kami</span>
                    <Title>Struktur Organisasi</Title>
                    <Paragraph className="mt-6">
                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Sapiente delectus architecto ullam earum, susunan tim yang solid untuk mendukung setiap lini usaha kami.
                    </Paragraph>
                </div>
            </Container>
        </section>

        <!-- Bagan -->
        <section id="struktur-bagan" class="relative mt-20">
            <Container>
                <div class="max-w-5xl mx-auto flex flex-col items-center gap-8">
                    <div class="bg-primary text-white rounded-2xl px-8 py-5 text-center shadow-lg min-w-[240px]">
                        <p class="font-bold">{tier1.title}</p>
                        <p class="text-sm opacity-80 mt-1">{tier1.name}</p>
                    </div>
                    <div class="w-px h-8 bg-box-border"></div>
                    <div class="bg-box-bg border-2 border-primary rounded-2xl px-8 py-5 text-center min-w-[240px]">
                        <p class="font-bold text-heading-1">{tier2.title}</p>
                        <p class="text-sm text-heading-3 mt-1">{tier2.name}</p>
                    </div>
                    <div class="w-px h-8 bg-box-border"></div>
                    <div class="w-full">
                        <div class="hidden md:block h-px bg-box-border mx-auto max-w-3xl"></div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8 max-w-3xl mx-auto">
                            {tier3.map((item) => (
                                <div class="relative">
                                    <div class="hidden md:block absolute -top-8 left-1/2 w-px h-8 bg-box-border -translate-x-1/2"></div>
                                    <div class="bg-box-bg border border-box-border rounded-2xl px-6 py-5 text-center h-full">
                                        <p class="font-bold text-heading-1">{item.title}</p>
                                        <p class="text-sm text-heading-3 mt-1">{item.name}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                    <div class="w-px h-8 bg-box-border"></div>
                    <div class="w-full">
                        <div class="hidden md:block h-px bg-box-border mx-auto max-w-3xl"></div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8 max-w-3xl mx-auto">
                            {tier4.map((item) => (
                                <div class="relative">
                                    <div class="hidden md:block absolute -top-8 left-1/2 w-px h-8 bg-box-border -translate-x-1/2"></div>
                                    <div class="bg-box-bg border border-box-border rounded-2xl px-6 py-5 text-center h-full">
                                        <p class="font-bold text-heading-1">{item.title}</p>
                                        <p class="text-sm text-heading-3 mt-1">{item.name}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </Container>
        </section>

        <!-- Divisi / Staff -->
        <section id="struktur-staff" class="relative mt-24">
            <Container>
                <div class="max-w-2xl mx-auto text-center mb-10">
                    <Title>Divisi Pendukung</Title>
                    <Paragraph className="mt-4">Setiap manajer didukung oleh tim yang berdedikasi di divisinya masing-masing.</Paragraph>
                </div>
                <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
                    {staffDivisions.map((item) => (
                        <span class="bg-box-bg border border-box-border rounded-full px-5 py-2 text-sm font-medium text-heading-2">{item}</span>
                    ))}
                </div>
            </Container>
        </section>
    </main>
</Layout>